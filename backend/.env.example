# MongoDB Atlas connection string
# Replace with your own connection string from MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/password_manager

# JWT secret key — use a long random string
JWT_SECRET=your-super-secret-key-change-this

# Admin setup secret — used to promote a user to admin via /setup-admin
ADMIN_SECRET=your-admin-setup-secret-change-this

# Server port (optional, defaults to 5000)
PORT=5000
